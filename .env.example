# MacroMatch — Environment Variables
# ------------------------------------
# Copy this file to .env and fill in your real API key.
# NEVER commit .env to git — it is already in .gitignore.

# Get your key from: https://console.anthropic.com/settings/keys
# Replace the placeholder below with your real key. Never commit the real value.
# If this file ever contained a real key, revoke it in the Anthropic console.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional — only needed when the API is not at http://127.0.0.1:8000
# (used by the Streamlit frontend, e.g. when pointing at a deployed API)
# MACROMATCH_API_URL=https://your-api.onrender.com
