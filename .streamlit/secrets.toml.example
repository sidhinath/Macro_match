# .streamlit/secrets.toml.example — TEMPLATE (commit this)
#
# Copy to .streamlit/secrets.toml and fill in real values. secrets.toml is
# git-ignored — never commit real secrets to the repository.

# Supabase — get these from Project Settings → API in your Supabase dashboard
SUPABASE_URL = "https://<your-project-ref>.supabase.co"
SUPABASE_ANON_KEY = "<your-anon-key>"

# Backend API URL used by the frontend (Render service or localhost).
MACROMATCH_API_URL = "http://127.0.0.1:8000"
