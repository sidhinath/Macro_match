# config.yaml.example — STRUCTURE ONLY. No real users or real secrets here.
#
# Copy this file to config.yaml (git-ignored) before running the app. The app
# also creates config.yaml automatically on first run if it is missing.
#
# Users are created through the app's "Sign up" tab. Passwords are hashed with
# bcrypt (via streamlit-authenticator) and are NEVER stored as plain text.
# Do NOT commit a config.yaml that contains real user data — it belongs in
# .gitignore along with .streamlit/secrets.toml.

credentials:
  usernames:
    # example_user:
    #   email: user@example.com
    #   name: Example User
    #   password: "$2b$12$..."   <- bcrypt hash, generated by the app

cookie:
  # Cookie name for the remember-me session cookie.
  name: macro_match_session
  # Cookie lifetime in days. 7 days = "remember me" for one week.
  expiry_days: 7
  # NOTE: the cookie SIGNING KEY is deliberately NOT here. It is read from
  # .streamlit/secrets.toml ([auth] cookie_key) at runtime so it never lives
  # in the repository.

# preauthorized:  # optional — list of emails allowed to sign up without approval
#   emails:
#     - user@example.com
